<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fx:id="helpPanel" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
            minWidth="0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <stylesheets>
    <URL value="@HelpPanel.css" />
  </stylesheets>
  <content>
    <VBox fx:id="helpContent" spacing="18" minWidth="0">
      <padding>
        <Insets top="10" right="10" bottom="10" left="10" />
      </padding>
      <VBox spacing="4">
        <Label fx:id="helpHeading" text="CouchCoach commands:" />
        <Label fx:id="helpHint" text="Type 'list' to see your players again."
               wrapText="true" minWidth="0" />
      </VBox>
      <GridPane fx:id="helpCommands" hgap="20" minWidth="0">
        <columnConstraints>
          <ColumnConstraints minWidth="180" prefWidth="180" maxWidth="180" />
          <ColumnConstraints hgrow="ALWAYS" minWidth="0" />
        </columnConstraints>
        <Label fx:id="addSyntax" text="add n/NAME p/PHONE&#10;[t/TAG]..."
               GridPane.columnIndex="0" GridPane.rowIndex="0" GridPane.valignment="TOP" />
        <Label fx:id="addDescription" text="Add a player with optional tags&#10;e.g. add n/Tan Wei Ming p/91234567 t/Striker"
               wrapText="true" minWidth="0"
               GridPane.columnIndex="1" GridPane.rowIndex="0" GridPane.valignment="TOP" />
        <Label fx:id="listSyntax" text="list"
               GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.valignment="TOP" />
        <Label fx:id="listDescription" text="Show all players" wrapText="true" minWidth="0"
               GridPane.columnIndex="1" GridPane.rowIndex="1" GridPane.valignment="TOP" />
        <Label fx:id="findSyntax" text="find KEYWORD..."
               GridPane.columnIndex="0" GridPane.rowIndex="2" GridPane.valignment="TOP" />
        <Label fx:id="findDescription"
               text="Show players whose names contain a keyword&#10;Matches whole words only, ignores capitalisation&#10;e.g. find wei ming"
               wrapText="true" minWidth="0"
               GridPane.columnIndex="1" GridPane.rowIndex="2" GridPane.valignment="TOP" />
        <Label fx:id="deleteSyntax" text="delete INDEX"
               GridPane.columnIndex="0" GridPane.rowIndex="3" GridPane.valignment="TOP" />
        <Label fx:id="deleteDescription"
               text="Delete the player at that position in the list&#10;shown right now. Positions change after a delete.&#10;e.g. delete 3"
               wrapText="true" minWidth="0"
               GridPane.columnIndex="1" GridPane.rowIndex="3" GridPane.valignment="TOP" />
        <Label fx:id="statusSyntax" text="keep INDEX&#10;cut INDEX&#10;pending INDEX"
               GridPane.columnIndex="0" GridPane.rowIndex="4" GridPane.valignment="TOP" />
        <Label fx:id="statusDescription"
               text="Mark the player at that position as kept, cut,&#10;or not yet decided (pending)&#10;e.g. keep 3"
               wrapText="true" minWidth="0"
               GridPane.columnIndex="1" GridPane.rowIndex="4" GridPane.valignment="TOP" />
        <Label fx:id="squadSyntax" text="squad"
               GridPane.columnIndex="0" GridPane.rowIndex="5" GridPane.valignment="TOP" />
        <Label fx:id="squadDescription" text="Show only the players you have kept"
               wrapText="true" minWidth="0"
               GridPane.columnIndex="1" GridPane.rowIndex="5" GridPane.valignment="TOP" />
        <Label fx:id="helpSyntax" text="help"
               GridPane.columnIndex="0" GridPane.rowIndex="6" GridPane.valignment="TOP" />
        <Label fx:id="helpDescription" text="Show this summary" wrapText="true" minWidth="0"
               GridPane.columnIndex="1" GridPane.rowIndex="6" GridPane.valignment="TOP" />
        <Label fx:id="exitSyntax" text="exit"
               GridPane.columnIndex="0" GridPane.rowIndex="7" GridPane.valignment="TOP" />
        <Label fx:id="exitDescription" text="Close CouchCoach" wrapText="true" minWidth="0"
               GridPane.columnIndex="1" GridPane.rowIndex="7" GridPane.valignment="TOP" />
        <Label fx:id="rateSyntax" text="rate INDEX RATING"
               GridPane.columnIndex="0" GridPane.rowIndex="8" GridPane.valignment="TOP" />
        <Label fx:id="rateDescription" text="Set a player's rating (whole number 0 to 10)&#10;e.g. rate 1 8"
               wrapText="true" minWidth="0"
               GridPane.columnIndex="1" GridPane.rowIndex="8" GridPane.valignment="TOP" />
        <Label fx:id="editSyntax" text="edit INDEX [n/NAME]&#10;[p/PHONE] [t/TAG]..."
               GridPane.columnIndex="0" GridPane.rowIndex="9" GridPane.valignment="TOP" />
        <Label fx:id="editDescription"
               text="Edit the displayed player; tags replace existing tags&#10;A single empty t/ clears tags; omit t/ to keep them&#10;e.g. edit 1 t/Striker t/Captain"
               wrapText="true" minWidth="0"
               GridPane.columnIndex="1" GridPane.rowIndex="9" GridPane.valignment="TOP" />
        <Label fx:id="filterSyntax" text="filter t/TAG [t/TAG]..."
               GridPane.columnIndex="0" GridPane.rowIndex="10" GridPane.valignment="TOP" />
        <Label fx:id="filterDescription"
               text="Show players with any requested tag&#10;Matches complete labels, ignores capitalisation&#10;e.g. filter t/Striker t/Trial Group 2"
               wrapText="true" minWidth="0"
               GridPane.columnIndex="1" GridPane.rowIndex="10" GridPane.valignment="TOP" />
        <Label fx:id="remarkSyntax" text="remark INDEX r/REMARK"
               GridPane.columnIndex="0" GridPane.rowIndex="11" GridPane.valignment="TOP" />
        <Label fx:id="remarkDescription"
               text="Set or replace a player remark; empty r/ clears it&#10;Use r/ only once; a second r/ after a space is rejected&#10;e.g. remark 1 r/Strong left foot"
               wrapText="true" minWidth="0"
               GridPane.columnIndex="1" GridPane.rowIndex="11" GridPane.valignment="TOP" />
        <Label fx:id="injurySyntax" text="injury INDEX i/STATUS"
               GridPane.columnIndex="0" GridPane.rowIndex="12" GridPane.valignment="TOP" />
        <Label fx:id="injuryDescription" text="Mark a player injured or fit again&#10;e.g. injury 1 i/injured or injury 1 i/fit"
               wrapText="true" minWidth="0"
               GridPane.columnIndex="1" GridPane.rowIndex="12" GridPane.valignment="TOP" />
      </GridPane>
      <Label fx:id="helpFooter" text="Your data is saved automatically after every change."
             wrapText="true" minWidth="0" />
    </VBox>
  </content>
</ScrollPane>
