<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox id="cardPane" fx:id="cardPane" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <GridPane HBox.hgrow="ALWAYS">
    <columnConstraints>
      <ColumnConstraints hgrow="SOMETIMES" minWidth="10" prefWidth="150" />
    </columnConstraints>
    <VBox alignment="CENTER_LEFT" minHeight="105" GridPane.columnIndex="0">
      <padding>
        <Insets top="5" right="5" bottom="5" left="15" />
      </padding>
      <!-- A GridPane, unlike an HBox, sizes this row for a wrapped name, so a long name wraps instead of hiding the badges -->
      <GridPane>
        <Label fx:id="id" styleClass="cell_big_label" GridPane.valignment="TOP">
          <minWidth>
            <!-- Ensures that the label text is never truncated -->
            <Region fx:constant="USE_PREF_SIZE" />
          </minWidth>
        </Label>
        <Label fx:id="name" text="\$first" styleClass="cell_big_label" wrapText="true" GridPane.columnIndex="1"
               GridPane.valignment="TOP" />
        <Label fx:id="selectionStatus" styleClass="selection-status" GridPane.columnIndex="2" GridPane.valignment="TOP">
          <minWidth>
            <Region fx:constant="USE_PREF_SIZE" />
          </minWidth>
          <GridPane.margin>
            <Insets top="2" left="10" />
          </GridPane.margin>
        </Label>
        <Label fx:id="injuryBadge" styleClass="injury-badge" text="Injured" GridPane.columnIndex="3"
               GridPane.valignment="TOP">
          <minWidth>
            <Region fx:constant="USE_PREF_SIZE" />
          </minWidth>
          <GridPane.margin>
            <Insets top="2" left="6" />
          </GridPane.margin>
        </Label>
      </GridPane>
      <Label fx:id="rating" styleClass="cell_small_label" text="Rating: Unrated" />
      <Label fx:id="phone" styleClass="cell_small_label" text="\$phone" />
      <Label fx:id="jerseyNumber" styleClass="cell_small_label" text="\$jerseyNumber" />
      <Label fx:id="remark" styleClass="cell_small_label" wrapText="true" minWidth="0" maxWidth="Infinity" />
      <FlowPane fx:id="tags" hgap="6" vgap="4" />
    </VBox>
  </GridPane>
</HBox>
