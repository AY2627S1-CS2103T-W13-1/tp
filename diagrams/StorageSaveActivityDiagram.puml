@startuml
skin rose
skinparam ActivityFontSize 15
skinparam ArrowFontSize 12
start
:LogicManager parses and
executes the command;
note right: A rejected command throws an\nexception here, so nothing is saved
if () then ([read-only command type])
  :Return the result;
  note right: list, find, filter, sort,\nsquad, help, exit
else ([any other command type])
  :Save the whole team
  through Storage;
  if () then ([save succeeds])
    :Return the result;
  else ([IOException])
    :Return applied-command feedback
    with a save warning, or
    SaveCommand.MESSAGE_FAILURE;
    note right: The Model is not rolled back.\nThe command box clears.\nFix storage, then type 'save'.
  endif
endif
stop
@enduml
