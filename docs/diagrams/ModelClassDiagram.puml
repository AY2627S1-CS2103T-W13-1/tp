@startuml
!pragma layout smetana
!include ModelDiagramStyle.puml

' View 1: contracts and model-owned data. Player internals are in the detail views.
interface Model <<interface>> {
    + updateFilteredPersonList(predicate): void
}
interface ReadOnlyAddressBook <<interface>>
interface ReadOnlyUserPrefs <<interface>>
class ModelManager {
    + addPerson(person): void
}
class AddressBook {
    + addPerson(person): void
}
class UserPrefs {
    + setGuiSettings(settings): void
}

ModelManager ..|> Model
AddressBook ..|> ReadOnlyAddressBook
UserPrefs ..|> ReadOnlyUserPrefs
Model ..> ReadOnlyAddressBook : uses
Model ..> ReadOnlyUserPrefs : uses
ModelManager "0..1" --> "1" AddressBook : addressBook
ModelManager "0..1" --> "1" UserPrefs : userPrefs
@enduml
