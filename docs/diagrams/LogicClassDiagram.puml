@startuml
!pragma layout smetana
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor LOGIC_COLOR_T4
skinparam classBackgroundColor LOGIC_COLOR

package Logic {
    interface Logic
    class LogicManager
    class AddressBookParser
    abstract class Command
    class CommandResult
}
interface Model MODEL_COLOR
interface Storage STORAGE_COLOR

LogicManager .up.|> Logic
LogicManager "1" --> "1" AddressBookParser : addressBookParser
LogicManager "0..*" --> "1" Model : model
LogicManager "0..*" --> "1" Storage : storage
LogicManager ..> Command : executes
AddressBookParser ..> Command : returns concrete command
Command ..> Model : uses during execute
Command ..> CommandResult : returns
Logic ..> CommandResult : returns
note bottom of AddressBookParser
Argument-bearing commands use command parsers.
Parameterless commands are constructed directly.
end note
@enduml
