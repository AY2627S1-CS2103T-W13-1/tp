@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam classBackgroundColor LOGIC_COLOR

class FilterCommandParser
class FilterCommand
class TagsContainAnyPredicate
class Person
class Tag
class "<<interface>>\nPredicate" as Predicate
class "<<interface>>\nModel" as Model

FilterCommandParser ..> FilterCommand : <<create>>
FilterCommandParser ..> TagsContainAnyPredicate : <<create>>
FilterCommand --> "1" TagsContainAnyPredicate : predicate
FilterCommand ..> Model : updates view
TagsContainAnyPredicate ..|> Predicate
TagsContainAnyPredicate ..> Person : tests
TagsContainAnyPredicate --> "1..*" Tag : requested tags
Person --> "0..*" Tag : player tags
@enduml
